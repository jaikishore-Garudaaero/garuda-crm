{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/vercel-config.mjs",
  "outputDirectory": "app",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(self)" }
    ] },
    { "source": "/(config.js|sw.js|index.html|register.html|q.html|garuda.html)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/js/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
